#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	aliases {
		sw0 = &hall_l;
		sw1 = &hall_r;
		sw2 = &gp_a;
		sw3 = &gp_b;
	};

	/* Red (PA5/TIM2_CH1) and green (PA6/TIM16_CH1) status LEDs on HW PWM so
	 * app_led can dim them (low duty ≈ 1/5 current, still clearly visible).
	 * The board's gpio-leds led_r/led_g stay defined but unused — app_led now
	 * references these pwm nodes. Yellow (PA4) has no timer channel and stays
	 * plain GPIO (led_y). Active-low LEDs → PWM_POLARITY_INVERTED. */
	pwmleds {
		compatible = "pwm-leds";

		led_r_pwm: led_r_pwm {
			pwms = <&pwm2 1 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
		};

		led_g_pwm: led_g_pwm {
			pwms = <&pwm16 1 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
		};
	};

	zephyr,user {
		pir-si-gpios = <&gpioa 11 GPIO_ACTIVE_HIGH>;
		pir-dl-gpios = <&gpiob 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		/* ST25DV GPO interrupt output (U11 pin 11 -> STM32 PB12, EXTI12),
		 * handled in app_nfc.c to wake the NFC handler on RF events. */
		nfc-gpo-gpios = <&gpiob 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
	};
};

/* Mark GPIOB (hosts the ST25DV GPO on PB12) as a system wake-up source so the
 * PM subsystem does NOT suspend the port when the CPU enters Stop2. Without this
 * the system-managed PM suspend sweep gates the port and the PB12 EXTI cannot
 * wake the MCU from Stop2 — so a phone tap on a sleeping (release) sticker went
 * unserviced. Paired with pm_device_wakeup_enable(gpiob) in app_nfc_init. */
&gpiob {
	wakeup-source;
};

/* Enable TIM2 (red LED, PA5/CH1) and TIM16 (green LED, PA6/CH1) as PWM. */
&timers2 {
	status = "okay";

	pwm2: pwm {
		status = "okay";
		pinctrl-0 = <&tim2_ch1_pa5>;
		pinctrl-names = "default";
	};
};

&timers16 {
	status = "okay";

	pwm16: pwm {
		status = "okay";
		pinctrl-0 = <&tim16_ch1_pa6>;
		pinctrl-names = "default";
	};
};
