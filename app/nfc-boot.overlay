/*
 * Variant-B flash layout for the application built to run behind the NFC
 * bootloader (doc/nfc-update-protocol.md §7). Same partition table as
 * boot/app.overlay, but here the app links at slot0 (code_partition).
 *
 * Passed explicitly (EXTRA_DTC_OVERLAY_FILE), NOT named app.overlay, so the
 * default flat build (which links from 0x0) is unaffected.
 *
 * Keep the partition table in sync with boot/app.overlay.
 */

#include <zephyr/dt-bindings/dt-util.h>

&flash0 {
	/delete-node/ partitions;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "boot";
			reg = <0x00000000 DT_SIZE_K(36)>;
		};

		slot0_partition: code_partition: partition@9000 {
			label = "code";
			reg = <0x00009000 DT_SIZE_K(162)>;
		};

		sfu_meta_partition: partition@31800 {
			label = "sfu_meta";
			reg = <0x00031800 DT_SIZE_K(2)>;
		};

		history_partition: partition@32000 {
			label = "history";
			reg = <0x00032000 DT_SIZE_K(40)>;
		};

		storage_partition: partition@3c000 {
			label = "storage";
			reg = <0x0003c000 DT_SIZE_K(16)>;
		};
	};
};

/ {
	chosen {
		zephyr,code-partition = &code_partition;
	};
};
