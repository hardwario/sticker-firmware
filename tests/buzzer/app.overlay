/* app_buzzer.c drives two GPIO output pins directly (pir-si-gpios/pir-dl-gpios
 * on real HW — shared with the PIR sensor, #338). Reuse native_sim's built-in
 * gpio0 (zephyr,gpio-emul) on two arbitrary pins so the test can read back
 * what the melody engine wrote via gpio_emul_output_get_dt(). */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	zephyr,user {
		pir-si-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
		pir-dl-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
	};
};
