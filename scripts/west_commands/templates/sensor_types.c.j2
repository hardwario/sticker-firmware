const struct app_sensor_type *app_sensor_type_get(uint8_t id)
{
	for (size_t i = 0; i < ARRAY_SIZE(m_types); i++) {
		if (m_types[i].id == id) {
			return &m_types[i];
		}
	}
	return NULL;
}

const struct app_sensor_type *app_sensor_type_by_family(uint8_t family)
{
	for (size_t i = 0; i < ARRAY_SIZE(m_types); i++) {
		if (family != 0 && m_types[i].w1_family == family) {
			return &m_types[i];
		}
	}
	return NULL;
}

const struct app_sensor_type *app_sensor_type_by_name(const char *name)
{
	for (size_t i = 0; i < ARRAY_SIZE(m_types); i++) {
		if (strcmp(m_types[i].name, name) == 0) {
			return &m_types[i];
		}
	}
	return NULL;
}

const struct app_sensor_channel *app_sensor_channel_get(uint8_t id, uint8_t ch)
{
	const struct app_sensor_type *t = app_sensor_type_get(id);

	if (t == NULL || ch >= t->channel_count) {
		return NULL;
	}
	return &t->channels[ch];
}

int app_sensor_channel_by_name(uint8_t id, const char *name)
{
	const struct app_sensor_type *t = app_sensor_type_get(id);

	if (t == NULL) {
		return -1;
	}
	for (uint8_t ch = 0; ch < t->channel_count; ch++) {
		if (strcmp(t->channels[ch].name, name) == 0) {
			return ch;
		}
	}
	return -1;
}

/* ---- Channel-vector helpers for struct app_sensor_data ------------------ */

/* They live here, not in app_sensor.c (the sampling loop and its drivers), so the
 * alarm / history host tests link them without the hardware layer. */

/* app_sensor_w1_f() addresses a dallas slot by the machine-probe numbering. */
BUILD_ASSERT((int)APP_SENSOR_CH_DALLAS_TEMPERATURE == (int)APP_SENSOR_CH_MACHINE_PROBE_TEMPERATURE,
	     "dallas and machine-probe primary temperature must share ch 0");

void app_sensor_w1_clear(struct app_sensor_w1 *s, uint8_t type)
{
	s->type = type;
	s->present = false;
	s->valid = 0;
	for (size_t ch = 0; ch < ARRAY_SIZE(s->v); ch++) {
		s->v[ch].f = NAN;
	}
}

void app_sensor_put_f(uint8_t type, union app_sensor_value *v, uint32_t *valid, uint8_t ch,
		      float value)
{
	const struct app_sensor_channel *c = app_sensor_channel_get(type, ch);

	if (c == NULL) {
		return;
	}
	if (!isfinite(value) ||
	    ((c->flags & APP_SENSOR_F_RANGE) && (value < c->range_min || value > c->range_max))) {
		v[ch].f = NAN;
		*valid &= ~BIT(ch);
		return;
	}
	v[ch].f = value;
	*valid |= BIT(ch);
}

int32_t app_sensor_wire_value(const struct app_sensor_channel *c, union app_sensor_value v)
{
	if (c->flags & APP_SENSOR_F_COUNTER) {
		return (int32_t)v.u;
	}
	return (int32_t)lroundf(v.f * c->wire_scale);
}

float app_sensor_w1_f(const struct app_sensor_w1 *s, uint8_t mp_ch)
{
	if (s->type == APP_SENSOR_TYPE_MACHINE_PROBE && mp_ch < APP_SENSOR_CH_MACHINE_PROBE_COUNT) {
		return s->v[mp_ch].f;
	}
	if (s->type == APP_SENSOR_TYPE_DALLAS && mp_ch == APP_SENSOR_CH_MACHINE_PROBE_TEMPERATURE) {
		return s->v[APP_SENSOR_CH_DALLAS_TEMPERATURE].f;
	}
	return NAN;
}
