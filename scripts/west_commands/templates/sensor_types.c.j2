const struct app_sensor_type *app_sensor_type_by_family(uint8_t family)
{
	for (size_t i = 0; i < ARRAY_SIZE(m_types); i++) {
		if (family != 0 && m_types[i].w1_family == family) {
			return &m_types[i];
		}
