// Sensor type registry, generated by `west sensorgen` from app_sensor_types.yaml
// (#430). type id -> { name, ch: [channel] }; a channel is
// { n: name, u: unit, k: kind, s: wire scale, h: [history enc, scale] | null,
//   p: part (1-Wire chip) }.
// Slot 0 is always type {{ mb.id }} ({{ mb.name }}); slots 1..4 carry their type on the wire.
var _SENSOR_TYPES = {
{% for t in types %}
  {{ t.id }}: {
    name: "{{ t.name }}",
    ch: [
{% for c in t.channels %}
      { n: "{{ c.name }}", u: "{{ c.unit }}", k: "{{ c.js_kind }}", s: {{ c.js_scale }}, h: {{ c.js_hist }}{{ (', p: "' ~ c.part_name ~ '"') if c.part_name }}{{ ', r: true' if c.retired }} }{{ ',' if not loop.last }}
{% endfor %}
    ]
  }{{ ',' if not loop.last }}
{% endfor %}
};
var _SENSOR_MB_TYPE = {{ mb.id }};
