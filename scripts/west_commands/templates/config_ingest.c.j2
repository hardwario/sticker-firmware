#include "{{ module.name }}_ingest.h"
#include "{{ module.name }}.h"
#include "app_log.h"

/* Zephyr includes */
#include <zephyr/logging/log.h>
#include <zephyr/sys/util.h>

/* Standard includes */
#include <errno.h>
#include <stdbool.h>
#include <stdint.h>
#include <string.h>

LOG_MODULE_REGISTER({{ module.name }}_ingest, LOG_LEVEL_DBG);

/* Record the first offending proto field tag and mark the result invalid. The
 * apply still processes the remaining fields (best effort) so NFC ingest keeps
 * its "skip invalid, apply the rest" behaviour; SetParam inspects fault_field. */
#define FAULT(tag)                                                                                 \
	do {                                                                                       \
		if (fault_field && *fault_field == 0) {                                            \
			*fault_field = (tag);                                                      \
		}                                                                                  \
		ret = -EINVAL;                                                                     \
	} while (0)

static bool requested(const uint32_t *ids, size_t n, uint32_t tag)
{
	for (size_t i = 0; i < n; i++) {
		if (ids[i] == tag) {
			return true;
		}
	}
	return false;
}
{% if has_omit_if_zero %}

/* True when a fixed-length bytes slot is all zero (unconfigured). Such slots are
 * omitted from a ConfigDump (dump_omit_if_zero in app_config.yml) so an
 * unprovisioned device pages its whole config into far fewer frames. */
static bool slot_all_zero(const uint8_t *slot, size_t len)
{
	for (size_t i = 0; i < len; i++) {
		if (slot[i]) {
			return false;
		}
	}
	return true;
}
{% endif %}

{% for g in ingest_groups %}
int {{ g.apply_fn }}(const {{ g.c_message }} *src, uint32_t *fault_field)
{
	struct {{ module.name }} *config = {{ module.name }}();
	int ret = 0;

	if (fault_field) {
		*fault_field = 0;
	}

{% for p in g.params %}
{% if p.kind == 'bool' %}
	if (src->has_{{ p.proto_name }}) {
		config->{{ p.c_name }} = src->{{ p.proto_name }};
	}
{% elif p.kind == 'enum' %}
	if (src->has_{{ p.proto_name }}) {
		if ((int)src->{{ p.proto_name }} >= 0 && (int)src->{{ p.proto_name }} <= {{ p.enum_max }}) {
			config->{{ p.c_name }} = ({{ p.c_enum_type }})src->{{ p.proto_name }};
		} else {
			FAULT({{ p.tag }});
		}
	}
{% elif p.kind == 'bytes' %}
	/* Native fixed_length bytes: nanopb decodes exactly sizeof(field) bytes. */
	if (src->has_{{ p.proto_name }}) {
		memcpy(config->{{ p.c_name }}, src->{{ p.proto_name }}, sizeof(config->{{ p.c_name }}));
	}
{% elif p.kind == 'float' %}
	if (src->has_{{ p.proto_name }}) {
		if (src->{{ p.proto_name }} >= {{ p.min }}f && src->{{ p.proto_name }} <= {{ p.max }}f) {
			config->{{ p.c_name }} = src->{{ p.proto_name }};
		} else {
			FAULT({{ p.tag }});
		}
	}
{% elif p.kind == 'int_ranged' %}
	if (src->has_{{ p.proto_name }}) {
		int val = src->{{ p.proto_name }};

		if ({% if p.zero_allowed %}val == 0 || {% endif %}(val >= {{ p.min }} && val <= {{ p.max }})) {
			config->{{ p.c_name }} = val;
		} else {
			FAULT({{ p.tag }});
		}
	}
{% else %}
	if (src->has_{{ p.proto_name }}) {
		config->{{ p.c_name }} = src->{{ p.proto_name }};
	}
{% endif %}
{% endfor %}
	return ret;
}

void {{ g.fill_fn }}({{ g.c_message }} *dst, const uint32_t *ids, size_t n)
{
	const struct {{ module.name }} *c = {{ module.name }}();

{% for p in g.params if (p.dump or p.dump_nfc_only) and not p.callback %}
{% if p.kind == 'bytes' and p.omit_if_zero %}
	if (requested(ids, n, {{ p.tag }}) &&
	    !slot_all_zero(c->{{ p.c_name }}, sizeof(c->{{ p.c_name }}))) {
		dst->has_{{ p.proto_name }} = true;
		memcpy(dst->{{ p.proto_name }}, c->{{ p.c_name }}, sizeof(c->{{ p.c_name }}));
	}
{% elif p.kind == 'bytes' %}
	if (requested(ids, n, {{ p.tag }})) {
		dst->has_{{ p.proto_name }} = true;
		memcpy(dst->{{ p.proto_name }}, c->{{ p.c_name }}, sizeof(c->{{ p.c_name }}));
	}
{% elif p.kind == 'enum' %}
	if (requested(ids, n, {{ p.tag }})) {
		dst->has_{{ p.proto_name }} = true;
		dst->{{ p.proto_name }} = ({{ p.proto_enum_type }})c->{{ p.c_name }};
	}
{% else %}
	if (requested(ids, n, {{ p.tag }})) {
		dst->has_{{ p.proto_name }} = true;
		dst->{{ p.proto_name }} = c->{{ p.c_name }};
	}
{% endif %}
{% endfor %}
}
{% if g.has_omit_if_zero %}

/* True when dump field `tag` in this group is an omit-if-zero slot that is
 * currently all zero (so fill_{{ g.key }}() omits it). The get_config paging loop
 * calls this to skip the slot's byte budget, keeping page_count exact. */
bool {{ g.slot_empty_fn }}(uint32_t tag)
{
	const struct {{ module.name }} *c = {{ module.name }}();

	switch (tag) {
{% for p in g.params if p.omit_if_zero %}
	case {{ p.tag }}:
		return slot_all_zero(c->{{ p.c_name }}, sizeof(c->{{ p.c_name }}));
{% endfor %}
	default:
		return false;
	}
}
{% endif %}

{% endfor %}
bool {{ module.name }}_ingest(const {{ message }} *message)
{
	if (message->has_factory && message->factory) {
		LOG_INF("Factory reset requested via NFC");
		return true;
	}

	/* Atomic ingest (H-11): apply every present group but capture the first fault,
	 * and roll the whole record back on any invalid field. A config record written
	 * over NFC with a bad field is now rejected outright (nothing applied) instead
	 * of half-applying the valid fields and silently looking like success — which
	 * left the device mis-provisioned with no indication. */
	struct {{ module.name }} snapshot = *{{ module.name }}();
	uint32_t fault = 0;
	int rc = 0;

{% for g in ingest_groups %}
	if (rc == 0 && message->has_{{ g.key }}) {
		rc = {{ g.apply_fn }}(&message->{{ g.key }}, &fault);
	}
{% endfor %}
	if (rc) {
		*{{ module.name }}() = snapshot;
		LOG_WRN("NFC config ingest rejected: invalid field (fault %u) — no change applied",
			fault);
	}
	return false;
}
