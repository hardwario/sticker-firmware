/* GENERATED by `west sensorgen` from app_w1_slots.yaml — do not edit (#430).
 *
 * Sensor type registry: slot 0 is the motherboard, slots 1..4 are 1-Wire slots
 * whose type is configured per slot. Every type publishes a channel table; a
 * channel is addressed as (type, ch). Type ids and channel numbers are
 * append-only (a removed channel stays with APP_SENSOR_F_RETIRED). */

#ifndef APP_SENSOR_TYPES_H_
#define APP_SENSOR_TYPES_H_

#include <stdbool.h>
#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

#define APP_SENSOR_REGISTRY_VERSION {{ version }}

/* Channel limits: the motherboard's valid mask is a uint32, a 1-Wire type's
 * reading array is sized APP_SENSOR_W1_CH_MAX (D6). */
#define APP_SENSOR_MB_CH_MAX {{ max_channels }}
#define APP_SENSOR_W1_CH_MAX {{ max_channels_w1 }}

enum app_sensor_type_id {
	APP_SENSOR_TYPE_NONE = 0,
{% for t in types %}
	{{ t.sym }} = {{ t.id }},
{% endfor %}
};

{% for t in types %}
/* {{ t.name }} channels */
enum app_sensor_ch_{{ t.cname }} {
{% for c in t.channels %}
	{{ c.sym }} = {{ c.ch }},
{% endfor %}
	APP_SENSOR_CH_{{ t.ident }}_COUNT
};

{% endfor %}
enum app_sensor_kind {
	APP_SENSOR_KIND_THRESHOLD, /* lo/hi/dwell */
	APP_SENSOR_KIND_STATE,     /* from/to/dwell (digital 0/1) */
	APP_SENSOR_KIND_RATE,      /* hi = max counter delta per report interval */
	APP_SENSOR_KIND_NONE,      /* value only, not an alarm target */
};

enum app_sensor_wire_type {
	APP_SENSOR_WIRE_SINT32,
	APP_SENSOR_WIRE_UINT32,
};

/* Fixed-width history encodings; the top value is the "absent" sentinel. */
enum app_sensor_hist_enc {
	APP_SENSOR_HIST_NONE, /* not recordable */
	APP_SENSOR_HIST_U8,
	APP_SENSOR_HIST_I16,
	APP_SENSOR_HIST_U16,
	APP_SENSOR_HIST_I32,
	APP_SENSOR_HIST_U32,
};

#define APP_SENSOR_F_MOMENTARY     0x01 /* pulse source, STATE rules are edge-only */
#define APP_SENSOR_F_COUNTER       0x02 /* raw uint32 counter (exact integer delta) */
#define APP_SENSOR_F_LIVENESS      0x04 /* watched by the no-data watchdog */
#define APP_SENSOR_F_WATCHDOG_ONLY 0x08 /* built-in watchdog input, not a rule target */
#define APP_SENSOR_F_RETIRED       0x10 /* kept for numbering only */
#define APP_SENSOR_F_RANGE         0x20 /* range_min/range_max are valid */

/* Capability gate of a motherboard channel: offset of its bool in struct
 * app_config, or APP_SENSOR_NO_CAP (always on / 1-Wire channel). */
#define APP_SENSOR_NO_CAP 0xFFFF

struct app_sensor_channel {
	const char *name;
	uint8_t kind;      /* enum app_sensor_kind */
	uint8_t flags;     /* APP_SENSOR_F_* */
	uint8_t wire_type; /* enum app_sensor_wire_type */
	uint8_t hist_enc;  /* enum app_sensor_hist_enc */
	uint16_t cap_off;  /* offsetof(struct app_config, cap_*) or APP_SENSOR_NO_CAP */
	float wire_scale;  /* wire value = round(phys * wire_scale) */
	float hist_scale;  /* history value = round(phys * hist_scale) */
	float range_min;   /* valid physical range (APP_SENSOR_F_RANGE) */
	float range_max;
};

struct app_sensor_type {
	const char *name;
	const struct app_sensor_channel *channels;
	uint8_t id;            /* enum app_sensor_type_id */
	uint8_t w1_family;     /* 1-Wire family code, 0 = motherboard */
	uint8_t channel_count; /* incl. retired channels */
};

/* Type by id / by 1-Wire family code / by name; NULL if unknown. */
const struct app_sensor_type *app_sensor_type_get(uint8_t id);
const struct app_sensor_type *app_sensor_type_by_family(uint8_t family);
const struct app_sensor_type *app_sensor_type_by_name(const char *name);

/* Channel `ch` of type `id`; NULL if the type or channel is unknown. */
const struct app_sensor_channel *app_sensor_channel_get(uint8_t id, uint8_t ch);

/* Channel number of `name` in type `id`, or -1. */
int app_sensor_channel_by_name(uint8_t id, const char *name);

#ifdef __cplusplus
}
#endif

#endif /* APP_SENSOR_TYPES_H_ */
